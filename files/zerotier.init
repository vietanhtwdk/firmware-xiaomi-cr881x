#!/bin/sh /etc/rc.common
# ZeroTier One. Join a network once with:
#   zerotier-cli join <network id>
# Identity and joined networks persist in /data/zerotier: on Xiaomi
# firmware only a few /etc entries are bind-mounted from /data.

START=90
USE_PROCD=1

HOME_DIR=/data/zerotier

start_service() {
	mkdir -p "$HOME_DIR"

	procd_open_instance
	procd_set_param command /usr/bin/zerotier-one "$HOME_DIR"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
