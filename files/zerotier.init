#!/bin/sh /etc/rc.common
# ZeroTier One. Join a network once with:
#   zerotier-cli join <network id>
# Identity and joined networks persist in /etc/zerotier.

START=90
USE_PROCD=1

HOME_DIR=/etc/zerotier

start_service() {
	mkdir -p "$HOME_DIR"

	procd_open_instance
	procd_set_param command /usr/bin/zerotier-one "$HOME_DIR"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
