#!/bin/sh /etc/rc.common
# ZeroTier One. Off by default so it does not sit in RAM unused; turn it on
# (persists, /data survives reboot) with:
#   mkdir -p /data/zerotier && touch /data/zerotier/enabled
#   /etc/init.d/zerotier start
#   zerotier-cli join <network id>
# Turn it back off with: rm /data/zerotier/enabled; /etc/init.d/zerotier stop
# Identity and joined networks persist in /data/zerotier: on Xiaomi firmware
# only a few /etc entries are bind-mounted from /data. rc.d is read-only, so
# the on/off switch is this flag file, not enable/disable.

START=90
USE_PROCD=1

HOME_DIR=/data/zerotier

start_service() {
	[ -f "$HOME_DIR/enabled" ] || return 0

	mkdir -p "$HOME_DIR" /var/lib
	# zerotier-cli looks for its auth token in the default home
	ln -sfn "$HOME_DIR" /var/lib/zerotier-one

	procd_open_instance
	procd_set_param command /usr/bin/zerotier-one "$HOME_DIR"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
