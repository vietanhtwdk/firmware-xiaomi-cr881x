/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Xiaomi CR881x";
	compatible = "xiaomi,cr881x", "qcom,ipq5018";

	aliases {
		label-mac-device = &gmac1;

		led-boot = &led_system_blue;
		led-failsafe = &led_system_red;
		led-running = &led_system_blue;
		led-upgrade = &led_system_red;

		serial0 = &blsp1_uart1;
	};

	chosen {
		/* Xiaomi's U-Boot passes ubi.mtd=rootfs or ubi.mtd=rootfs_1
		 * depending on the active slot, so only the root device is
		 * set here.
		 */
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mesh-button {
			label = "mesh";
			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};

		led_system_red: system-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led_internet_blue: internet-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};

		led_internet_red: internet-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <8>;
		nand-bus-width = <8>;

		/* sbl1 ... crash_syslog, rootfs (mtd18), rootfs_1 (mtd19),
		 * overlay (mtd20) are read from the MIBIB via SMEM.
		 */
		partitions {
			compatible = "qcom,smem-part";

			partition-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* Base MAC, the radios use +1 and +2 */
					macaddr_art_6: mac-address@6 {
						compatible = "mac-base";
						reg = <0x6 0x6>;
						#nvmem-cell-cells = <1>;
					};

					/* Used as WAN MAC by the stock firmware */
					macaddr_art_c: mac-address@c {
						compatible = "mac-base";
						reg = <0xc 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

/*
 * =================================================================
 *     _______________________             _______________________
 *    |        IPQ5018        |           |        YT9215         |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | | MAC0 |---| GE Phy |-+--- MDI ---+ | Phy4   |---| MAC4 | | (unused)
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | | MAC1 |---| Uniphy |-+-2500base-x+ | SerDes |---| MAC8 | |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    |_______________________|           |_______________________|
 *
 * YT9215 Phy0..2 -> LAN1..3, Phy3 -> WAN
 * =================================================================
 */

&uniphy0 {
	status = "okay";
};

// MAC1 ---2500base-x---> YT9215 MAC8
&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	nvmem-cells = <&macaddr_art_6 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	switch@1d {
		compatible = "motorcomm,yt9215";
		reg = <0x1d>;

		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw_phy0: ethernet-phy@0 {
				reg = <0>;
			};

			sw_phy1: ethernet-phy@1 {
				reg = <1>;
			};

			sw_phy2: ethernet-phy@2 {
				reg = <2>;
			};

			sw_phy3: ethernet-phy@3 {
				reg = <3>;
			};
		};

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@0 {
				reg = <0>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&sw_phy0>;
			};

			ethernet-port@1 {
				reg = <1>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&sw_phy1>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&sw_phy2>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "wan";
				phy-mode = "internal";
				phy-handle = <&sw_phy3>;

				nvmem-cells = <&macaddr_art_c 0>;
				nvmem-cell-names = "mac-address";
			};

			ethernet-port@8 {
				reg = <8>;
				phy-mode = "2500base-x";
				ethernet = <&gmac1>;

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio28", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio24", "gpio25", "gpio26", "gpio27";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};

&q6v5_wcss {
	/* The QCN6102 radio should map to UPD ID 2. Without       */
	/* bootargs, the firmware will expect it to be on UPD ID 3 */
	boot-args = </*       type: */ 0x2 /* PCIE1 */
		     /*     length: */ 4
		     /*      PD id: */ 2
		     /* reset GPIO: */ 18
		     /*   reserved: */ 0 0>;

	status = "okay";
};

&wifi {
	// IPQ5018 2.4G
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Xiaomi-CR881x";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	// QCN6102 5G
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Xiaomi-CR881x";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
