#!/bin/sh

. /lib/functions.sh

# No NSS on mainline: use software flow offloading and spread packet
# processing over both cores instead.
case "$(board_name)" in
xiaomi,cr881x)
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q commit firewall
	uci -q set network.globals.packet_steering='1'
	uci -q commit network
	;;
esac

exit 0
